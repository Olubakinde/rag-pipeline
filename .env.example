# Copy to .env and adjust as needed. Every value shown is the default.

RAG_QDRANT_PATH=data/qdrant
RAG_COLLECTION_NAME=documents
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_MAX_UPLOAD_MB=10

# Uncomment to enable cross-encoder re-ranking.
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_RERANK_CANDIDATES=20
